# DSSH — SSH connection config
# Copy this to sd:/3ds/3dssh/config.ini and edit values for your server.

# SSH server hostname or IP
host = your-server.example.com

# SSH port (default 22)
port = 22

# Username on the server
user = ubuntu

# Path to your RSA private key on the SD card.
# Generate this on your PC with (-m PEM is REQUIRED — see note below):
#   ssh-keygen -t rsa -b 4096 -m PEM -f ~/.ssh/id_rsa_3ds -C "3ds-ssh-client"
# Then ssh-copy-id the public key to the server, and copy the private key here.
#
# IMPORTANT: 3DS mbedtls 2.28 only parses traditional PEM keys
# (-----BEGIN RSA PRIVATE KEY-----).  Without -m PEM, modern ssh-keygen
# emits OpenSSH format (-----BEGIN OPENSSH PRIVATE KEY-----) and the 3DS
# will fail with "auth failed" at handshake.  Convert an existing key
# in place with:  ssh-keygen -p -m PEM -f ~/.ssh/id_rsa_3ds
key_path = sdmc:/3ds/3dssh/id_rsa

# Passphrase for the key, or leave empty for an unencrypted key.
# (Recommended: unencrypted, since the SD card is the only place the key lives.)
passphrase =

# Optional: automatically unlock the current SSH user's macOS login keychain.
# Leave empty to disable it.
# The password is sent only after the interactive PTY shows its unlock prompt;
# it is never placed in a command-line argument or shell history.
# Quote it if it contains # or leading/trailing spaces, for example:
#   macos_keychain_password = "my # password"
#
# SECURITY WARNING: this stores your macOS login password in plaintext on the
# removable SD card. Prefer a dedicated macOS account and keep the SD card safe.
macos_keychain_password =

# Optional native Tailscale transport. Setting an auth key enables Tailscale.
# Later launches also start automatically when tailscale.state exists, so the
# key may remain configured but removing it reduces exposure on the SD card.
tailscale_auth_key =

# Optional values below use these defaults when omitted or left empty.
tailscale_hostname = dssh-3ds
tailscale_state = sdmc:/3ds/3dssh/tailscale.state
tailscale_control_url = https://controlplane.tailscale.com
